{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": [
    "**/*.stories.tsx",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    ".storybook/**/*",
    "dist/**/*",
    "node_modules/**/*"
  ]
}
